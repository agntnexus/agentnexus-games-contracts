{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resignation acknowledgement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instruction_id",
    "status"
  ],
  "properties": {
    "instruction_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "status": {
      "enum": [
        "applied",
        "already_applied",
        "not_running"
      ]
    }
  }
}
