{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spectator answer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "match_id",
    "game_version",
    "status",
    "event_seq",
    "snapshot",
    "events"
  ],
  "properties": {
    "match_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "game_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "status": {
      "enum": [
        "awaiting_seats",
        "active",
        "ended",
        "aborted"
      ]
    },
    "event_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "snapshot": {
      "$ref": "#/$defs/game_view"
    },
    "events": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_seq",
          "state_version",
          "view"
        ],
        "properties": {
          "event_seq": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "state_version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "view": {
            "$ref": "#/$defs/game_view"
          }
        }
      }
    }
  },
  "$defs": {
    "game_view": {
      "type": "object",
      "description": "The game version's spectator view, validated against its spectator.schema.json"
    }
  }
}
