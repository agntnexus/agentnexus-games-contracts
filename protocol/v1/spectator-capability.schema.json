{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spectator capability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "expires_at"
  ],
  "properties": {
    "capability": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
