{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Outcome, agentnexus-outcome-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "key_id",
    "match_id",
    "provider_id",
    "game_version",
    "result",
    "reason",
    "winner_seat",
    "solo",
    "final_state_version",
    "replay_digest",
    "replay_reference",
    "reported_at",
    "signature"
  ],
  "properties": {
    "version": {
      "x-agentnexus-data-class": "public",
      "x-agentnexus-retained": true,
      "const": "agentnexus-outcome-v1"
    },
    "key_id": {
      "x-agentnexus-data-class": "public",
      "x-agentnexus-retained": true,
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "match_id": {
      "x-agentnexus-data-class": "public",
      "x-agentnexus-retained": true,
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "provider_id": {
      "x-agentnexus-data-class": "public",
      "x-agentnexus-retained": true,
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "game_version": {
      "x-agentnexus-data-class": "public",
      "x-agentnexus-retained": true,
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "result": {
      "x-agentnexus-data-class": "public",
      "x-agentnexus-retained": true,
      "enum": [
        "win",
        "draw",
        "aborted"
      ]
    },
    "reason": {
      "x-agentnexus-data-class": "public",
      "x-agentnexus-retained": true,
      "enum": [
        "rules",
        "resignation",
        "forfeit",
        "provider"
      ]
    },
    "winner_seat": {
      "x-agentnexus-data-class": "public",
      "x-agentnexus-retained": true,
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        }
      ]
    },
    "solo": {
      "x-agentnexus-data-class": "public",
      "x-agentnexus-retained": true,
      "type": "boolean"
    },
    "final_state_version": {
      "x-agentnexus-data-class": "public",
      "x-agentnexus-retained": true,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "replay_digest": {
      "x-agentnexus-data-class": "public",
      "x-agentnexus-retained": true,
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "replay_reference": {
      "x-agentnexus-data-class": "public",
      "x-agentnexus-retained": true,
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "reported_at": {
      "x-agentnexus-data-class": "public",
      "x-agentnexus-retained": true,
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "signature": {
      "x-agentnexus-data-class": "public",
      "x-agentnexus-retained": true,
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  },
  "if": {
    "properties": {
      "result": {
        "const": "win"
      }
    }
  },
  "then": {
    "properties": {
      "winner_seat": {
        "type": "string"
      }
    }
  },
  "else": {
    "properties": {
      "winner_seat": {
        "type": "null"
      }
    }
  }
}
