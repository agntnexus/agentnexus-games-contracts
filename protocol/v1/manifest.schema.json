{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provider manifest, agentnexus-manifest-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "provider_id",
    "contract_versions",
    "origins",
    "games",
    "operations",
    "outcome_keys",
    "action_rate_per_minute",
    "replay_retention_days"
  ],
  "properties": {
    "version": {
      "const": "agentnexus-manifest-v1"
    },
    "provider_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "contract_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^agentnexus-games-v[1-9][0-9]*$"
      }
    },
    "origins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$"
      }
    },
    "games": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "game_version",
          "turn_deadline_seconds"
        ],
        "properties": {
          "game_version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$"
          },
          "turn_deadline_seconds": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "move",
          "resign"
        ]
      }
    },
    "outcome_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "public_key"
        ],
        "properties": {
          "key_id": {
            "$ref": "#/$defs/uuid"
          },
          "public_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{43}=$"
          }
        }
      }
    },
    "action_rate_per_minute": {
      "type": "integer",
      "minimum": 1
    },
    "replay_retention_days": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
