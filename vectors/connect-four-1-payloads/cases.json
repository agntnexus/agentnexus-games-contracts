{
  "description": "Conformance cases for the payloads of game version connect-four-1 and the size limits, as D-118 fixes them. Test material: no case is a move in a real match, and no contract version is published with this file.",
  "decision": "D-118",
  "game_version": "connect-four-1",
  "schemas": {
    "move": "games/connect-four/connect-four-1/move.schema.json",
    "observation": "games/connect-four/connect-four-1/observation.schema.json"
  },
  "shared_ceilings": {
    "move": 4096,
    "observation": 65536
  },
  "message_limits": [
    {
      "message": "redemption",
      "fixed_bytes": 4096,
      "plus": null,
      "over_limit_code": "too_large"
    },
    {
      "message": "resumption",
      "fixed_bytes": 1024,
      "plus": null,
      "over_limit_code": "too_large"
    },
    {
      "message": "action",
      "fixed_bytes": 1024,
      "plus": "move_ceiling",
      "over_limit_code": "too_large"
    },
    {
      "message": "resignation_instruction",
      "fixed_bytes": 2048,
      "plus": null,
      "over_limit_code": "too_large"
    },
    {
      "message": "resignation_acknowledgement",
      "fixed_bytes": 1024,
      "plus": null,
      "over_limit_code": null
    },
    {
      "message": "seat_answer",
      "fixed_bytes": 1024,
      "plus": "observation_bound",
      "over_limit_code": null
    },
    {
      "message": "refusal",
      "fixed_bytes": 1024,
      "plus": null,
      "over_limit_code": null
    }
  ],
  "move_cases": [
    {
      "name": "column-0",
      "expected": "valid",
      "move": {
        "column": 0
      }
    },
    {
      "name": "column-6",
      "expected": "valid",
      "move": {
        "column": 6
      }
    },
    {
      "name": "column-minus-1",
      "expected": "invalid",
      "because": "below column 0",
      "move": {
        "column": -1
      }
    },
    {
      "name": "column-7",
      "expected": "invalid",
      "because": "above column 6",
      "move": {
        "column": 7
      }
    },
    {
      "name": "no-column",
      "expected": "invalid",
      "because": "`column` is required",
      "move": {}
    },
    {
      "name": "column-as-string",
      "expected": "invalid",
      "because": "a column is an integer",
      "move": {
        "column": "3"
      }
    },
    {
      "name": "column-as-fraction",
      "expected": "invalid",
      "because": "a column is an integer",
      "move": {
        "column": 2.5
      }
    },
    {
      "name": "column-as-boolean",
      "expected": "invalid",
      "because": "`true` is not an integer",
      "move": {
        "column": true
      }
    },
    {
      "name": "unknown-member",
      "expected": "invalid",
      "because": "a member the schema does not name",
      "move": {
        "column": 3,
        "row": 0
      }
    }
  ],
