{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seat answer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "seat_generation",
    "sequence",
    "state_version",
    "status",
    "observation"
  ],
  "properties": {
    "seat_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "state_version": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "awaiting_seats",
        "active",
        "ended",
        "aborted"
      ]
    },
    "observation": {
      "$ref": "#/$defs/game_payload"
    }
  },
  "$defs": {
    "game_payload": {
      "type": "object",
      "description": "The game version's own observation for this seat; its schema and field classes are open (WQ-2)"
    }
  }
}
