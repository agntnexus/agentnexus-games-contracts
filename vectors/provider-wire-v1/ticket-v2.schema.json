{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Match grant ticket, version 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "key_id",
    "ticket_id",
    "match_id",
    "seat",
    "seat_generation",
    "provider_id",
    "game_version",
    "operations",
    "session_key_fingerprint",
    "not_before",
    "not_after",
    "signature"
  ],
  "properties": {
    "version": {
      "const": "agentnexus-grant-v2"
    },
    "key_id": {
      "$ref": "#/$defs/uuid"
    },
    "ticket_id": {
      "$ref": "#/$defs/uuid"
    },
    "match_id": {
      "$ref": "#/$defs/uuid"
    },
    "seat": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "seat_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "provider_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "game_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "operations": {
      "type": "array",
      "items": {
        "enum": [
          "move",
          "resign"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "session_key_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "not_before": {
      "$ref": "#/$defs/time"
    },
    "not_after": {
      "$ref": "#/$defs/time"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
